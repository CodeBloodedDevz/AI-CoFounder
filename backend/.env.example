# Copy this file to backend/.env and fill in the values (ask the project owner for them privately).
# backend/.env is git-ignored: never commit it, and never put these keys in the app.

SUPABASE_URL=https://lkcarrbnfgpffmixcyqx.supabase.co
# Supabase → Project Settings → API Keys → Secret keys (starts with sb_secret_)
SUPABASE_SERVICE_ROLE_KEY=
PORT=4000

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
GROQ_VOICE_MODEL=llama-3.3-70b-versatile
# Models are checked against your Groq account at start-up; run "npm run check-ai" to see them.

# Secret used to protect account recovery keys. Must be the SAME value as production,
# or existing recovery keys stop working.
RECOVERY_SECRET=
# Only when the server runs behind a proxy / hosting platform (so rate limits see real visitor IPs):
# TRUST_PROXY=1

# Paystack → Settings → API Keys (use the sk_test_ key)
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=ZAR
PUBLIC_API_URL=http://localhost:4000
# Where the customer lands when they tap "Return to the app" (your web app address).
APP_URL=http://localhost:8081
# Going live later = put an sk_live_ key above AND set this to true. Without it a live key is refused.
PAYSTACK_ALLOW_LIVE=false
ENFORCE_PLAN_LIMITS=true
PAYMENT_EXPIRY_MINUTES=60
