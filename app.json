{
  "expo": {
    "name": "AI Co-Founder",
    "slug": "ai-cofounder",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aicofounder.app"
    },
    "android": {
      "package": "com.aicofounder.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF4D6D"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "AI Co-Founder uses the microphone so you can record voice notes and talk to your AI business partner.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8234C6",
          "defaultChannel": "appointments"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AI Co-Founder uses your photos so you can add your logo and pictures to your adverts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F9FF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "eed81fa0-a986-4e60-99d7-535e196b120c"
      }
    },
    "owner": "nkosingiphilemt"
  }
}
